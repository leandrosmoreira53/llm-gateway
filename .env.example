# Copie para .env e preencha. O .env nunca vai para o git.

# OpenRouter — obrigatório para o benchmark (V0) e para o gateway (V1+)
OPENROUTER_API_KEY=
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1

# Jev / TypeSafe — teste simulado do Jev (V0) e política ao vivo (V2)
TYPESAFE_API_KEY=

# Gabarito do benchmark (arquivo JSONL fora do repositório)
BENCH_DATASET_PATH=

# Tempo-limite das chamadas HTTP, em segundos
HTTP_CONNECT_TIMEOUT_SECONDS=10
HTTP_TIMEOUT_SECONDS=120
